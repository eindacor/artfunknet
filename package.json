{
  "name": "artfunknet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "db:up": "docker compose --env-file .env.local up -d mongodb",
    "db:down": "docker compose --env-file .env.local down",
    "db:seed": "node --env-file=.env.local scripts/seed.mjs",
    "db:bootstrap-admin": "node --env-file=.env.production scripts/bootstrap-admin.mjs",
    "db:publish-artwork": "node --env-file=.env.local scripts/publish-approved-artwork.mjs",
    "artwork:manifest": "node --env-file=.env.local scripts/export-artwork-image-manifest.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1123.0",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "jose": "^6.2.10",
    "mongodb": "^7.6.0",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9",
    "eslint-config-next": "^16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
